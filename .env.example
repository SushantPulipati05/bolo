# Copy this file to .env.local and fill in your values. Never commit .env.local.

# Your Sarvam API key (dashboard: https://indus.sarvam.ai/key-management)
SARVAM_API_KEY=

# Optional: if set, every API call must send this passcode (protects your credits once deployed)
APP_PASSCODE=

# Optional: defaults shown. Pick a speaker from the Bulbul v4 Flash voice catalog in the docs.
SARVAM_TTS_SPEAKER=simran_en_customer
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_STT_MODEL=saaras:v4
SARVAM_CHAT_MODEL=sarvam-105b
